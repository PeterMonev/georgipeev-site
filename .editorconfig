# Top-most file — no parent .editorconfig is consulted above this one.
root = true

# ---------------------------------------------------------------- all files
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,ts,tsx,js,jsx,css,html}]
indent_size = 2

[*.{csproj,props,targets,config,xml}]
indent_size = 2

# ------------------------------------------------------------------- C#
[*.cs]

# ---- using directives ----
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# ---- modern syntax ----
# File-scoped namespaces: one less level of indentation in every single file.
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion

# ---- var ----
# Use var where the type is already written on the right-hand side.
# Do not force it where the type is not obvious from reading the line.
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion

# ---- expressions ----
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
csharp_style_prefer_pattern_matching = true:warning
csharp_style_throw_expression = true:suggestion

# ---- null handling ----
# The whole point of enabling nullable reference types is to lean on them.
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
csharp_style_prefer_null_check_over_type_check = true:warning

# ---- readonly and scope ----
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_prefer_static_local_function = true:warning

# ---- unused code ----
dotnet_code_quality_unused_parameters = all:warning
csharp_style_unused_value_assignment_preference = discard_variable:warning

# ------------------------------------------------------------------ naming
# private fields: _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# interfaces: IThing
dotnet_naming_rule.interfaces_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_prefixed.style = i_prefix
dotnet_naming_rule.interfaces_prefixed.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix.required_prefix = I
dotnet_naming_style.i_prefix.capitalization = pascal_case

# everything else public: PascalCase
dotnet_naming_rule.members_pascal.symbols = public_members
dotnet_naming_rule.members_pascal.style = pascal
dotnet_naming_rule.members_pascal.severity = warning
dotnet_naming_symbols.public_members.applicable_kinds = property,method,event,class,struct,enum,delegate
dotnet_naming_symbols.public_members.applicable_accessibilities = public,internal,protected
dotnet_naming_style.pascal.capitalization = pascal_case